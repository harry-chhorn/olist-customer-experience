      <aliases enabled='yes' />
      <column caption='Orders' datatype='integer' name='[Calculation_5459556316000256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Late Rate' datatype='real' default-format='p0.0%' name='[Calculation_5459556316196865]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IIF([days_late] &gt; 0, 1, 0))' />
      </column>
      <column caption='Bad Review Rate' datatype='real' default-format='p0.0%' name='[Calculation_5459556320280578]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IIF([review_score] &lt;= 2, 1, 0))' />
      </column>
      <column caption='Avg Review' datatype='real' name='[Calculation_5459556320530435]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([review_score])' />
      </column>
      <column caption='Delivery Status' datatype='string' name='[Calculation_5459556320681988]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IIF([days_late] &gt; 0, &quot;Late&quot;, &quot;On time&quot;)' />
      </column>
      <column caption='Late Orders' datatype='integer' name='[Calculation_5459556920053765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IIF([days_late] &gt; 0, 1, 0))' />
      </column>
      <column caption='Promised Days' datatype='integer' name='[Calculation_5459556920438790]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&apos;day&apos;, DATE([order_purchase_timestamp]), DATE([order_estimated_delivery_date]))' />
      </column>
      <column caption='Delay Group' datatype='string' name='[Calculation_5459556920766471]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [days_late] &lt;= 0 THEN &quot;On time&quot;&#10;ELSEIF [days_late] &lt;= 3 THEN &quot;1–3 days late&quot;&#10;ELSEIF [days_late] &lt;= 7 THEN &quot;4–7 days late&quot;&#10;ELSE &quot;8+ days late&quot;&#10;END' />
      </column>
      <column caption='Star' datatype='string' name='[Calculation_5459556935643145]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([review_score]) + &quot;★&quot;' />
      </column>
      <column caption='Orders in Group' datatype='integer' name='[Calculation_5459556943040523]' role='measure' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Calculation_5459556920766471] : COUNTD([order_id]) }' />
      </column>
      <column caption='Row Label' datatype='string' name='[Calculation_5459556943888396]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_5459556920766471] + CHAR(10) +&#10;(IF [Calculation_5459556943040523] &gt;= 1000&#10; THEN STR(INT([Calculation_5459556943040523] / 1000)) + &quot;,&quot; + RIGHT(&quot;00&quot; + STR([Calculation_5459556943040523] % 1000), 3)&#10; ELSE STR([Calculation_5459556943040523])&#10; END) + &quot; orders&quot;' />
      </column>
      <column caption='Pct Label' datatype='real' name='[Calculation_5459556946395149]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5459556316000256] / TOTAL([Calculation_5459556316000256]) &gt;= 0.08&#10;THEN [Calculation_5459556316000256] / TOTAL([Calculation_5459556316000256])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Bad Review KPI' datatype='string' name='[Calculation_5459557563846672]' role='measure' type='nominal'>
        <calculation class='tableau' formula='STR(INT(ROUND(AVG(IIF([days_late] &gt; 0, IIF([review_score] &lt;= 2, 1, 0), NULL)) * 100, 0)))&#10;+ &quot;% vs &quot; +&#10;STR(INT(ROUND(AVG(IIF([days_late] &lt;= 0, IIF([review_score] &lt;= 2, 1, 0), NULL)) * 100, 0)))&#10;+ &quot;%&quot;' />
      </column>
