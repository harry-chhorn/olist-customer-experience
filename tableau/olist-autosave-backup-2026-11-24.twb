    <worksheet name='Star_bar'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true'>           The later the order arrive, the more customers jump straight to one star</run>
            <run>Æ&#10;</run>
            <run fontcolor='#898989' fontsize='12'>              Share of review at each star rating</run>
            <run fontalignment='1'>Æ&#10;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='tableau_orders' name='federated.10jgn8v0zdx99x14nt4pv14agmno' />
          </datasources>
          <datasource-dependencies datasource='federated.10jgn8v0zdx99x14nt4pv14agmno'>
            <column caption='Orders' datatype='integer' name='[Calculation_5459556316000256]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD([order_id])' />
            </column>
            <column caption='Delay Group' datatype='string' name='[Calculation_5459556920766471]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [days_late] &lt;= 0 THEN &quot;On time&quot;&#10;ELSEIF [days_late] &lt;= 3 THEN &quot;1–3 days late&quot;&#10;ELSEIF [days_late] &lt;= 7 THEN &quot;4–7 days late&quot;&#10;ELSE &quot;8+ days late&quot;&#10;END' />
            </column>
            <column caption='Star' datatype='string' name='[Calculation_5459556935643145]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='STR([review_score]) + &quot;★&quot;' />
            </column>
            <column caption='Orders in Group' datatype='integer' name='[Calculation_5459556943040523]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='{ FIXED [Calculation_5459556920766471] : COUNTD([order_id]) }' />
            </column>
            <column caption='Row Label' datatype='string' name='[Calculation_5459556943888396]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Calculation_5459556920766471] + CHAR(10) +&#10;(IF [Calculation_5459556943040523] &gt;= 1000&#10; THEN STR(INT([Calculation_5459556943040523] / 1000)) + &quot;,&quot; + RIGHT(&quot;00&quot; + STR([Calculation_5459556943040523] % 1000), 3)&#10; ELSE STR([Calculation_5459556943040523])&#10; END) + &quot; orders&quot;' />
            </column>
            <column caption='Pct Label' datatype='real' name='[Calculation_5459556946395149]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_5459556316000256] / TOTAL([Calculation_5459556316000256]) &gt;= 0.08&#10;THEN [Calculation_5459556316000256] / TOTAL([Calculation_5459556316000256])&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Sum' caption='Days Late' datatype='integer' name='[days_late]' role='dimension' type='quantitative' />
            <column-instance column='[Calculation_5459556935643145]' derivation='None' name='[none:Calculation_5459556935643145:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_5459556943888396]' derivation='None' name='[none:Calculation_5459556943888396:nk]' pivot='key' type='nominal' />
            <column caption='Order Id' datatype='string' name='[order_id]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_5459556316000256]' derivation='User' name='[pcto:usr:Calculation_5459556316000256:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.10jgn8v0zdx99x14nt4pv14agmno].[none:Calculation_5459556935643145:nk]' ordering-type='Field' type='PctTotal' />
            </column-instance>
            <column caption='Review Score' datatype='integer' name='[review_score]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_5459556946395149]' derivation='User' name='[usr:Calculation_5459556946395149:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-field='[federated.10jgn8v0zdx99x14nt4pv14agmno].[none:Calculation_5459556935643145:nk]' ordering-type='Field' />
            </column-instance>
